<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 920 {{ layout.total_height | default(1550) }}" width="100%" height="100%" style="background-color: #ffffff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <defs>
    <!-- Card Drop Shadows -->
    <filter id="softShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.08"/>
    </filter>
    <filter id="badgeShadow" x="-15%" y="-15%" width="130%" height="130%">
      <feDropShadow dx="0" dy="3" stdDeviation="4" flood-opacity="0.14"/>
    </filter>

    <!-- Water Depth Gradient from TAW 0m to curve -->
    <linearGradient id="waterDepthGrad" gradientUnits="userSpaceOnUse" x1="70" y1="0" x2="850" y2="0">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.02"/>
      <stop offset="22%" stop-color="#38bdf8" stop-opacity="0.06"/>
      <stop offset="60%" stop-color="#0ea5e9" stop-opacity="0.16"/>
      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.28"/>
    </linearGradient>

    <linearGradient id="legendWaterGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.05"/>
    </linearGradient>

    <!-- Horizontal Current Bars Gradients (dynamically scaled) -->
    <linearGradient id="floodBarGrad" gradientUnits="userSpaceOnUse" x1="495" y1="0" x2="{{ layout.flood_grad_x2 | default(825) }}" y2="0">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.75"/>
      <stop offset="100%" stop-color="#0284c7" stop-opacity="1.0"/>
    </linearGradient>
    <linearGradient id="ebbBarGrad" gradientUnits="userSpaceOnUse" x1="425" y1="0" x2="{{ layout.ebb_grad_x2 | default(95) }}" y2="0">
      <stop offset="0%" stop-color="#818cf8" stop-opacity="0.75"/>
      <stop offset="100%" stop-color="#4f46e5" stop-opacity="1.0"/>
    </linearGradient>

    <!-- Base Arrow Definition (pointing Right at 0°) -->
    <g id="vectorArrow">
      <line x1="-4.5" y1="0" x2="4.5" y2="0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M 1.5 -3 L 4.5 0 L 1.5 3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
  </defs>

  <!-- Canvas Background (Solid White) -->
  <rect x="0" y="0" width="920" height="{{ layout.total_height | default(1550) }}" fill="#ffffff"/>

  <!-- ================= HEADER SECTION (CENTERED) ================= -->
  <g id="header" transform="translate(0, 36)">
    <!-- Centered Titles -->
    <text x="460" y="20" font-size="12.5" font-weight="800" letter-spacing="1.8" fill="#0284c7" text-anchor="middle">{{ meta.project_title | default("CSCM KUST-STROMINGSPROFIEL") }}</text>
    <text x="460" y="58" font-size="{{ meta.title_size | default(32) }}" font-weight="900" fill="#0f172a" letter-spacing="-0.5" text-anchor="middle">{{ meta.location_name }}</text>
    <text x="460" y="84" font-size="14.5" font-weight="500" fill="#64748b" text-anchor="middle">{{ meta.date_str }} • {{ meta.time_window }} • <tspan font-weight="800" fill="{{ meta.regime_color | default('#0284c7') }}">{{ meta.regime_label }}</tspan></text>

    <!-- Compass Rosette with Horizontal Coastline Reference (Top Right) -->
    <g id="compass" transform="translate(775, 2)">
      <circle cx="45" cy="45" r="38" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1.5" filter="url(#softShadow)"/>
      <line x1="12" y1="45" x2="78" y2="45" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3,3"/>
      <text x="45" y="41" font-size="7" font-weight="800" fill="#64748b" letter-spacing="1" text-anchor="middle">KUSTLIJN</text>
      <text x="45" y="32" font-size="6.5" font-weight="700" fill="#0284c7" text-anchor="middle">▲ ZEE</text>
      <text x="45" y="56" font-size="6.5" font-weight="700" fill="#94a3b8" text-anchor="middle">▼ STRAND</text>
      <!-- Rotated North Needle -->
      <g transform="translate(45, 45) rotate({{ meta.north_angle | default(25) }})">
        <polygon points="0,-30 6,-8 0,-14 -6,-8" fill="#ef4444"/>
        <polygon points="0,18 6,0 0,6 -6,0" fill="#94a3b8"/>
        <text x="0" y="-33" font-size="10.5" font-weight="900" fill="#ef4444" text-anchor="middle">N</text>
      </g>
    </g>
  </g>

  <!-- ================= COASTAL DIRECTION BAR ================= -->
  <g id="coast_direction" transform="translate(45, 145)">
    <rect x="0" y="0" width="830" height="42" rx="8" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1.2"/>
    
    <!-- Left: Alongshore Left / Ebb -->
    <g transform="translate(18, 21)">
      <path d="M 16 0 L 0 0 M 0 0 L 6 -5 M 0 0 L 6 5" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <text x="26" y="5" font-size="12.5" font-weight="800" fill="#4f46e5">{{ meta.coast_left_label | default("[FR] FRANKRIJK • EBBESTROOM (ZW)") }}</text>
    </g>

    <!-- Center Separator -->
    <circle cx="415" cy="21" r="3.5" fill="#cbd5e1"/>

    <!-- Right: Alongshore Right / Flood -->
    <g transform="translate(812, 21)">
      <path d="M -16 0 L 0 0 M 0 0 L -6 -5 M 0 0 L -6 5" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <text x="-26" y="5" font-size="12.5" font-weight="800" fill="#0284c7" text-anchor="end">{{ meta.coast_right_label | default("VLOEDSTROOM (NO) • NEDERLAND [NL]") }}</text>
    </g>
  </g>

  <!-- ================= GRAPH MAIN AREA (DYNAMIC SCALE & TICKS) ================= -->
  <g id="graph_surface">
    <!-- Grid lines (Dynamic from layout.ticks) -->
    <g id="grid_lines" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="3,4">
      {% for tick in layout.ticks %}
        <line x1="{{ tick.x }}" y1="202" x2="{{ tick.x }}" y2="{{ layout.grid_y_bottom }}"/>
      {% endfor %}
    </g>

    <!-- Scale Headers (Dynamic from layout.ticks) -->
    <g id="scale_headers" font-size="10" font-weight="700" fill="#94a3b8" text-anchor="middle">
      {% for tick in layout.ticks %}
        {% if tick.val < 0 %}
          <text x="{{ tick.x }}" y="202">{{ tick.label }}</text>
        {% endif %}
      {% endfor %}
      <text x="460" y="202" fill="#64748b" font-weight="800">TIJD</text>
      {% for tick in layout.ticks %}
        {% if tick.val > 0 %}
          <text x="{{ tick.x }}" y="202">{{ tick.label }}</text>
        {% endif %}
      {% endfor %}
    </g>

    <!-- Swimmer Speed Benchmarks (Dynamic from layout.benchmarks) -->
    <g id="swimmer_benchmarks">
      {% for b in layout.benchmarks %}
        <line x1="{{ b.flood_x }}" y1="208" x2="{{ b.flood_x }}" y2="{{ layout.benchmark_y_bottom }}" stroke="{{ b.stroke }}" stroke-width="{{ b.width }}" stroke-dasharray="4,4" opacity="0.8"/>
        <line x1="{{ b.ebb_x }}" y1="208" x2="{{ b.ebb_x }}" y2="{{ layout.benchmark_y_bottom }}" stroke="{{ b.ebb_stroke }}" stroke-width="{{ b.width }}" stroke-dasharray="4,4" opacity="0.8"/>
      {% endfor %}
    </g>

    <!-- ================= WATER LEVEL UNDERLAY ================= -->
    {% if water_level %}
    <g id="water_level_curve">
      {% if water_level.area_d %}
      <path d="{{ water_level.area_d }}" fill="url(#waterDepthGrad)"/>
      {% endif %}
      {% if water_level.line_d %}
      <path d="{{ water_level.line_d }}" fill="none" stroke="#0ea5e9" stroke-width="3.5" stroke-linecap="round" opacity="0.9"/>
      {% endif %}
    </g>
    {% endif %}

    <!-- Central Spine Guides -->
    <line x1="425" y1="208" x2="425" y2="{{ layout.benchmark_y_bottom | default(1220) }}" stroke="#cbd5e1" stroke-width="1.2"/>
    <line x1="495" y1="208" x2="495" y2="{{ layout.benchmark_y_bottom | default(1220) }}" stroke="#cbd5e1" stroke-width="1.2"/>

    <!-- ================= CURRENT VECTOR BARS & ROTATING ARROWS ================= -->
    <g id="current_bars">
      {% set scale = layout.scale_px_per_mps | default(220.0) %}
      {% for slot in slots %}
        {% if slot.v > 0.05 %}
          <!-- Flood bar (Right from X=495) -->
          {% set bar_len = (slot.v * scale) | round(1) %}
          {% set end_x = 495 + bar_len %}
          {% if slot.is_pfc %}
            <!-- Highlight for Peak Flood Current (PFC) - Blue Family -->
            <rect x="495" y="{{ slot.y - 10 }}" width="{{ bar_len + 6 }}" height="20" rx="10" fill="#e0f2fe" opacity="0.8"/>
            <line x1="495" y1="{{ slot.y }}" x2="{{ end_x }}" y2="{{ slot.y }}" stroke="#0284c7" stroke-width="7.5" stroke-linecap="round"/>
            <circle cx="{{ end_x }}" cy="{{ slot.y }}" r="11" fill="#0284c7" stroke="#ffffff" stroke-width="2" filter="url(#badgeShadow)"/>
            <g transform="translate({{ end_x }}, {{ slot.y }}) rotate({{ slot.angle }})" style="color: #ffffff;">
              <use href="#vectorArrow"/>
            </g>
            <g transform="translate({{ end_x + 18 }}, {{ slot.y }})">
              <text x="0" y="-2" font-size="13" font-weight="900" fill="#0284c7" paint-order="stroke" stroke="#ffffff" stroke-width="3.5">{{ slot.v }} m/s</text>
              <text x="0" y="11" font-size="9.5" font-weight="800" fill="#0369a1" paint-order="stroke" stroke="#ffffff" stroke-width="3">PIEK VLOED (PFC)</text>
            </g>
          {% else %}
            <!-- Standard Flood bar -->
            <line x1="495" y1="{{ slot.y }}" x2="{{ end_x }}" y2="{{ slot.y }}" stroke="url(#floodBarGrad)" stroke-width="5" stroke-linecap="round"/>
            <circle cx="{{ end_x }}" cy="{{ slot.y }}" r="8" fill="#ffffff" stroke="#0284c7" stroke-width="1.6"/>
            <g transform="translate({{ end_x }}, {{ slot.y }}) rotate({{ slot.angle }})" style="color: #0284c7;">
              <use href="#vectorArrow"/>
            </g>
          {% endif %}
        {% elif slot.v < -0.05 %}
          <!-- Ebb bar (Left from X=425) -->
          {% set bar_len = ((-slot.v) * scale) | round(1) %}
          {% set end_x = 425 - bar_len %}
          {% if slot.is_pec %}
            <!-- Highlight for Peak Ebb Current (PEC) - Purple Family -->
            <rect x="{{ end_x }}" y="{{ slot.y - 10 }}" width="{{ bar_len }}" height="20" rx="10" fill="#ede9fe" opacity="0.8"/>
            <line x1="425" y1="{{ slot.y }}" x2="{{ end_x }}" y2="{{ slot.y }}" stroke="#4f46e5" stroke-width="7.5" stroke-linecap="round"/>
            <circle cx="{{ end_x }}" cy="{{ slot.y }}" r="11" fill="#4f46e5" stroke="#ffffff" stroke-width="2" filter="url(#badgeShadow)"/>
            <g transform="translate({{ end_x }}, {{ slot.y }}) rotate({{ slot.angle }})" style="color: #ffffff;">
              <use href="#vectorArrow"/>
            </g>
            <g transform="translate({{ end_x - 18 }}, {{ slot.y }})">
              <text x="0" y="-2" font-size="13" font-weight="900" fill="#4f46e5" text-anchor="end" paint-order="stroke" stroke="#ffffff" stroke-width="3.5">{{ slot.v }} m/s</text>
              <text x="0" y="11" font-size="9.5" font-weight="800" fill="#4338ca" text-anchor="end" paint-order="stroke" stroke="#ffffff" stroke-width="3">PIEK EB (PEC)</text>
            </g>
          {% else %}
            <!-- Standard Ebb bar -->
            <line x1="425" y1="{{ slot.y }}" x2="{{ end_x }}" y2="{{ slot.y }}" stroke="url(#ebbBarGrad)" stroke-width="5" stroke-linecap="round"/>
            <circle cx="{{ end_x }}" cy="{{ slot.y }}" r="8" fill="#ffffff" stroke="#4f46e5" stroke-width="1.6"/>
            <g transform="translate({{ end_x }}, {{ slot.y }}) rotate({{ slot.angle }})" style="color: #4f46e5;">
              <use href="#vectorArrow"/>
            </g>
          {% endif %}
        {% else %}
          <!-- Kentering / Slack Water (v ≈ 0.0 m/s) -->
          <circle cx="460" cy="{{ slot.y }}" r="8.5" fill="#ffffff" stroke="#16a34a" stroke-width="2" filter="url(#softShadow)"/>
          <g transform="translate(460, {{ slot.y }}) rotate({{ slot.angle }})" style="color: #16a34a;">
            <use href="#vectorArrow"/>
          </g>
        {% endif %}
      {% endfor %}
    </g>

    <!-- ================= TIME SPINE & TICK MARKS ================= -->
    <g id="time_spine">
      {% for slot in slots %}
        {% if slot.is_pfc and slot.is_hw %}
          <!-- Dual badge when PFC and HW coincide at exact same time slot -->
          <g filter="url(#badgeShadow)">
            <rect x="426" y="{{ slot.y - 11 }}" width="34" height="22" rx="4" fill="#0284c7"/>
            <rect x="460" y="{{ slot.y - 11 }}" width="34" height="22" rx="4" fill="#f59e0b"/>
            <rect x="426" y="{{ slot.y - 11 }}" width="68" height="22" rx="5" fill="none" stroke="#ffffff" stroke-width="1.2"/>
          </g>
          <text x="460" y="{{ slot.y + 4.5 }}" fill="#ffffff" font-family="monospace" font-size="11.5" font-weight="900" text-anchor="middle">{{ slot.time }}</text>
        {% elif slot.is_pfc %}
          <rect x="426" y="{{ slot.y - 11 }}" width="68" height="22" rx="5" fill="#0284c7" filter="url(#badgeShadow)"/>
          <text x="460" y="{{ slot.y + 4.5 }}" fill="#ffffff" font-family="monospace" font-size="11.5" font-weight="900" text-anchor="middle">{{ slot.time }}</text>
        {% elif slot.is_hw %}
          <rect x="426" y="{{ slot.y - 11 }}" width="68" height="22" rx="5" fill="#f59e0b" filter="url(#badgeShadow)"/>
          <text x="460" y="{{ slot.y + 4.5 }}" fill="#ffffff" font-family="monospace" font-size="11.5" font-weight="900" text-anchor="middle">{{ slot.time }}</text>
        {% elif slot.is_kentering %}
          <rect x="424" y="{{ slot.y - 11 }}" width="72" height="22" rx="5" fill="#16a34a" filter="url(#badgeShadow)"/>
          <text x="460" y="{{ slot.y + 4.5 }}" fill="#ffffff" font-family="monospace" font-size="11.5" font-weight="900" text-anchor="middle">{{ slot.time }}</text>
          {% if slot.v >= 0 %}
            <text x="410" y="{{ slot.y + 4 }}" font-size="10.5" font-weight="800" fill="#15803d" text-anchor="end" paint-order="stroke" stroke="#ffffff" stroke-width="3">KENTERING (≈ 0 m/s)</text>
          {% else %}
            <text x="510" y="{{ slot.y + 4 }}" font-size="10.5" font-weight="800" fill="#15803d" text-anchor="start" paint-order="stroke" stroke="#ffffff" stroke-width="3">KENTERING (≈ 0 m/s)</text>
          {% endif %}
        {% elif slot.is_pec %}
          <rect x="426" y="{{ slot.y - 11 }}" width="68" height="22" rx="5" fill="#4f46e5" filter="url(#badgeShadow)"/>
          <text x="460" y="{{ slot.y + 4.5 }}" fill="#ffffff" font-family="monospace" font-size="11.5" font-weight="900" text-anchor="middle">{{ slot.time }}</text>
        {% elif slot.is_lw %}
          <rect x="426" y="{{ slot.y - 11 }}" width="68" height="22" rx="5" fill="#ea580c" filter="url(#badgeShadow)"/>
          <text x="460" y="{{ slot.y + 4.5 }}" fill="#ffffff" font-family="monospace" font-size="11.5" font-weight="900" text-anchor="middle">{{ slot.time }}</text>
        {% elif slot.minute == 0 %}
          <text x="460" y="{{ slot.y + 4 }}" fill="#475569" font-family="monospace" font-size="11" font-weight="800" text-anchor="middle">{{ slot.hour_label }}</text>
        {% else %}
          <g transform="translate(460, {{ slot.y }})">
            <circle cx="0" cy="0" r="4.2" fill="#ffffff" stroke="#94a3b8" stroke-width="0.9"/>
            {% if slot.quarter_type == 1 %}
              <path d="M 0 0 L 0 -4.2 A 4.2 4.2 0 0 1 4.2 0 Z" fill="#64748b"/>
            {% elif slot.quarter_type == 2 %}
              <path d="M 0 0 L 0 -4.2 A 4.2 4.2 0 0 1 0 4.2 Z" fill="#64748b"/>
            {% elif slot.quarter_type == 3 %}
              <path d="M 0 0 L 0 -4.2 A 4.2 4.2 0 1 1 -4.2 0 Z" fill="#64748b"/>
            {% endif %}
          </g>
        {% endif %}
      {% endfor %}
    </g>

    <!-- ================= WATER LEVEL CALLOUT BADGES (ALWAYS ON TOP) ================= -->
    {% if water_level %}
    <g id="water_level_callouts">
      <!-- High Water Marker Callout (Always points right into open canvas margin) -->
      {% if water_level.hw %}
      {% set hw_offset_x = [22, 755 - water_level.hw.x] | max %}
      <g transform="translate({{ water_level.hw.x }}, {{ water_level.hw.y }})">
        <circle cx="0" cy="0" r="6" fill="#f59e0b" stroke="#ffffff" stroke-width="2" filter="url(#badgeShadow)"/>
        <line x1="6" y1="0" x2="{{ hw_offset_x }}" y2="0" stroke="#f59e0b" stroke-width="1.8" stroke-dasharray="2,2"/>
        <g transform="translate({{ hw_offset_x }}, -20)">
          <rect x="0" y="0" width="84" height="42" rx="6" fill="#fef3c7" stroke="#f59e0b" stroke-width="1.2" filter="url(#softShadow)"/>
          <text x="8" y="16" font-size="9.5" font-weight="800" fill="#b45309">HOOGWATER</text>
          <text x="8" y="32" font-size="13" font-weight="900" fill="#92400e">{{ water_level.hw.height }}</text>
        </g>
      </g>
      {% endif %}

      <!-- Low Water 1 Marker Callout (Points left into open margin away from ebb bars) -->
      {% if water_level.lw1 %}
      <g transform="translate({{ water_level.lw1.x }}, {{ water_level.lw1.y }})">
        <circle cx="0" cy="0" r="6" fill="#ea580c" stroke="#ffffff" stroke-width="2" filter="url(#badgeShadow)"/>
        <line x1="-6" y1="0" x2="-20" y2="0" stroke="#ea580c" stroke-width="1.8" stroke-dasharray="2,2"/>
        <g transform="translate(-106, -20)">
          <rect x="0" y="0" width="84" height="42" rx="6" fill="#ffedd5" stroke="#ea580c" stroke-width="1.2" filter="url(#softShadow)"/>
          <text x="8" y="16" font-size="9.5" font-weight="800" fill="#c2410c">LAAGWATER</text>
          <text x="8" y="32" font-size="13" font-weight="900" fill="#9a3412">{{ water_level.lw1.height }}</text>
        </g>
      </g>
      {% endif %}

      <!-- Low Water 2 Marker Callout -->
      {% if water_level.lw2 %}
      <g transform="translate({{ water_level.lw2.x }}, {{ water_level.lw2.y }})">
        <circle cx="0" cy="0" r="6" fill="#ea580c" stroke="#ffffff" stroke-width="2" filter="url(#badgeShadow)"/>
        <line x1="-6" y1="0" x2="-22" y2="0" stroke="#ea580c" stroke-width="1.8" stroke-dasharray="2,2"/>
        <g transform="translate(-112, -20)">
          <rect x="0" y="0" width="86" height="42" rx="6" fill="#ffedd5" stroke="#ea580c" stroke-width="1.2" filter="url(#softShadow)"/>
          <text x="8" y="16" font-size="9.5" font-weight="800" fill="#c2410c">LAAGWATER</text>
          <text x="8" y="32" font-size="13" font-weight="900" fill="#9a3412">{{ water_level.lw2.height }}</text>
        </g>
      </g>
      {% endif %}
    </g>
    {% endif %}
  </g>

  <!-- ================= SWIMMER PACE BENCHMARK CALLOUTS ================= -->
  <g id="swimmer_benchmark_callouts">
    {% for c in layout.swimmer_callouts %}
      {% if c.speed == 0.5 %}
        <!-- 0.5 m/s: Straight vertical entry into pill top corners -->
        <line x1="{{ c.ebb_x }}" y1="{{ layout.benchmark_y_bottom }}" x2="{{ c.ebb_x }}" y2="{{ c.y - 11 }}" stroke="{{ c.border }}" stroke-width="1.4"/>
        <circle cx="{{ c.ebb_x }}" cy="{{ layout.benchmark_y_bottom }}" r="3.5" fill="{{ c.border }}"/>

        <line x1="{{ c.flood_x }}" y1="{{ layout.benchmark_y_bottom }}" x2="{{ c.flood_x }}" y2="{{ c.y - 11 }}" stroke="{{ c.border }}" stroke-width="1.4"/>
        <circle cx="{{ c.flood_x }}" cy="{{ layout.benchmark_y_bottom }}" r="3.5" fill="{{ c.border }}"/>
      {% else %}
        <!-- 1.0 & 1.5 m/s: Smooth curves into pill side edges -->
        <path d="M {{ c.ebb_x }} {{ layout.benchmark_y_bottom }} C {{ c.ebb_x }} {{ c.y }} {{ 315 - 20 }} {{ c.y }} 315 {{ c.y }}" fill="none" stroke="{{ c.border }}" stroke-width="1.4" stroke-linecap="round"/>
        <circle cx="{{ c.ebb_x }}" cy="{{ layout.benchmark_y_bottom }}" r="3.5" fill="{{ c.border }}"/>

        <path d="M {{ c.flood_x }} {{ layout.benchmark_y_bottom }} C {{ c.flood_x }} {{ c.y }} {{ 605 + 20 }} {{ c.y }} 605 {{ c.y }}" fill="none" stroke="{{ c.border }}" stroke-width="1.4" stroke-linecap="round"/>
        <circle cx="{{ c.flood_x }}" cy="{{ layout.benchmark_y_bottom }}" r="3.5" fill="{{ c.border }}"/>
      {% endif %}

      <!-- Benchmark Pill (Centered between X=315 and X=605) -->
      <g id="callout_pill_{{ loop.index }}">
        <rect x="315" y="{{ c.y - 11 }}" width="290" height="22" rx="5" fill="{{ c.bg }}" stroke="{{ c.border }}" stroke-width="1.2" filter="url(#softShadow)"/>
        <circle cx="327" cy="{{ c.y }}" r="3.5" fill="{{ c.color }}"/>
        <text x="337" y="{{ c.y + 3.8 }}">
          <tspan font-size="10.5" font-weight="900" fill="{{ c.color }}">{{ c.speed_str }}</tspan>
          <tspan font-size="9.5" font-weight="600" fill="#64748b"> (≈ {{ c.kmh_str }})</tspan>
          <tspan font-size="10" font-weight="700" fill="#334155"> • {{ c.label }}</tspan>
        </text>
        <text x="595" y="{{ c.y + 3.8 }}" font-size="9" font-weight="600" fill="#94a3b8" text-anchor="end">{{ c.sub }}</text>
      </g>
    {% endfor %}
  </g>

  <!-- ================= FOOTER / LEGEND ================= -->
  <g id="legend" transform="translate(45, {{ layout.legend_y | default(1422) }})">
    <rect x="0" y="0" width="830" height="106" rx="8" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
    
    <!-- Row 1: Line styles with dual-colored actual bar and curving water line -->
    <g transform="translate(24, 22)">
      <!-- Dual-colored Current Vector Bar -->
      <g transform="translate(0, 0)">
        <circle cx="8" cy="0" r="7" fill="#ffffff" stroke="#4f46e5" stroke-width="1.6"/>
        <path d="M 10 0 L 6 0 M 8 -2.5 L 6 0 L 8 2.5" fill="none" stroke="#4f46e5" stroke-width="1.6" stroke-linecap="round"/>
        <rect x="15" y="-3.5" width="22" height="7" rx="1.5" fill="#4f46e5"/>
        <rect x="37" y="-3.5" width="22" height="7" rx="1.5" fill="#0284c7"/>
        <line x1="37" y1="-3.5" x2="37" y2="3.5" stroke="#ffffff" stroke-width="1.2"/>
        <circle cx="66" cy="0" r="7" fill="#ffffff" stroke="#0284c7" stroke-width="1.6"/>
        <path d="M 64 0 L 68 0 M 66 -2.5 L 68 0 L 66 2.5" fill="none" stroke="#0284c7" stroke-width="1.6" stroke-linecap="round"/>
        <text x="84" y="4" font-size="11.5" font-weight="600" fill="#334155">Stroomsnelheid (lengte balk) &amp; Stroomhoek (pijltje)</text>
      </g>

      <!-- Curving Water Level Wave with Gradient -->
      <g transform="translate(480, 0)">
        <path d="M 0 5 Q 12 -6 24 5 Q 36 16 48 5 L 48 12 L 0 12 Z" fill="url(#legendWaterGrad)"/>
        <path d="M 0 5 Q 12 -6 24 5 Q 36 16 48 5" fill="none" stroke="#0ea5e9" stroke-width="3" stroke-linecap="round"/>
        <text x="60" y="4" font-size="11.5" font-weight="600" fill="#334155">Waterstandscurve (m TAW)</text>
      </g>
    </g>

    <!-- Row 2: Badges and Timestamps (evenly spaced across width) -->
    <g transform="translate(24, 48)">
      <!-- Col 1: Blue PFC -->
      <g transform="translate(0, 0)">
        <rect x="0" y="0" width="14" height="14" rx="3.5" fill="#0284c7"/>
        <text x="20" y="11.5" font-size="11" font-weight="700" fill="#334155">Piek Vloed (PFC)</text>
        <rect x="0" y="22" width="48" height="20" rx="4" fill="#0284c7" filter="url(#badgeShadow)"/>
        <text x="24" y="36" fill="#ffffff" font-family="monospace" font-size="10.5" font-weight="900" text-anchor="middle">{{ legend_events.pfc.time }}</text>
        <text x="54" y="36" font-size="10.5" font-weight="800" fill="#0284c7">{{ legend_events.pfc.val }}</text>
      </g>

      <!-- Col 2: Amber HW -->
      <g transform="translate(160, 0)">
        <rect x="0" y="0" width="14" height="14" rx="3.5" fill="#f59e0b"/>
        <text x="20" y="11.5" font-size="11" font-weight="700" fill="#334155">Hoogwater (HW)</text>
        <rect x="0" y="22" width="48" height="20" rx="4" fill="#f59e0b" filter="url(#badgeShadow)"/>
        <text x="24" y="36" fill="#ffffff" font-family="monospace" font-size="10.5" font-weight="900" text-anchor="middle">{{ legend_events.hw.time }}</text>
        <text x="54" y="36" font-size="10.5" font-weight="800" fill="#d97706">{{ legend_events.hw.val }}</text>
      </g>

      <!-- Col 3: Green Kentering -->
      <g transform="translate(320, 0)">
        <rect x="0" y="0" width="14" height="14" rx="3.5" fill="#16a34a"/>
        <text x="20" y="11.5" font-size="11" font-weight="700" fill="#334155">Kentering (≈ 0 m/s)</text>
        <g transform="translate(0, 22)">
          {% for kt in legend_events.kenteringen %}
            <g transform="translate({{ loop.index0 * 50 }}, 0)">
              <rect x="0" y="0" width="46" height="20" rx="4" fill="#16a34a" filter="url(#badgeShadow)"/>
              <text x="23" y="14" fill="#ffffff" font-family="monospace" font-size="10" font-weight="900" text-anchor="middle">{{ kt }}</text>
            </g>
          {% endfor %}
        </g>
      </g>

      <!-- Col 4: Indigo PEC -->
      <g transform="translate(490, 0)">
        <rect x="0" y="0" width="14" height="14" rx="3.5" fill="#4f46e5"/>
        <text x="20" y="11.5" font-size="11" font-weight="700" fill="#334155">Piek Eb (PEC)</text>
        <rect x="0" y="22" width="48" height="20" rx="4" fill="#4f46e5" filter="url(#badgeShadow)"/>
        <text x="24" y="36" fill="#ffffff" font-family="monospace" font-size="10.5" font-weight="900" text-anchor="middle">{{ legend_events.pec.time }}</text>
        <text x="54" y="36" font-size="10.5" font-weight="800" fill="#4f46e5">{{ legend_events.pec.val }}</text>
      </g>

      <!-- Col 5: Orange LW -->
      <g transform="translate(645, 0)">
        <rect x="0" y="0" width="14" height="14" rx="3.5" fill="#ea580c"/>
        <text x="20" y="11.5" font-size="11" font-weight="700" fill="#334155">Laagwater (LW)</text>
        <rect x="0" y="22" width="48" height="20" rx="4" fill="#ea580c" filter="url(#badgeShadow)"/>
        <text x="24" y="36" fill="#ffffff" font-family="monospace" font-size="10.5" font-weight="900" text-anchor="middle">{{ legend_events.lw.time }}</text>
        <text x="54" y="36" font-size="10.5" font-weight="800" fill="#ea580c">{{ legend_events.lw.val }}</text>
      </g>
    </g>
  </g>

  <!-- ================= SUB-FOOTER BRANDING & SOURCE ================= -->
  <g id="footer" transform="translate(45, {{ layout.footer_y | default(1532) }})">
    <text x="0" y="0" font-size="10.5" font-weight="600" fill="#94a3b8">{{ meta.source_label }}</text>
    <text x="830" y="0" font-size="10.5" font-weight="700" fill="#94a3b8" text-anchor="end">CSCM • CHANNEL SWIMMING CURRENT MODEL</text>
  </g>
</svg>
